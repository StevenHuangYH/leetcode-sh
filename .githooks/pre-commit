#!/usr/bin/env bash
# LeetCode-SH Pre-Commit Validation Hook
# Validates Markdown schema compliance, runs unit tests, and compiles index.html before commit

set -e

echo "[pre-commit] 1/3 Auditing Markdown note schema compliance (strict mode)..."
python3 update_index.py --lint --strict

echo "[pre-commit] 2/3 Running repository unit tests..."
python3 -m unittest discover tests

echo "[pre-commit] 3/3 Compiling index.html study station..."
python3 update_index.py

git add index.html

echo "[pre-commit] All pre-commit validations passed successfully."

