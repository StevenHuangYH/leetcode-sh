#!/usr/bin/env bash
# LeetCode-SH Pre-Commit Validation Hook
# Validates Markdown schema compliance and compiles index.html before commit

set -e

echo "[pre-commit] Validating Markdown note schema compliance..."
python3 update_index.py --lint

echo "[pre-commit] Compiling index.html study station..."
python3 update_index.py

git add index.html

echo "[pre-commit] All pre-commit validations passed successfully."
